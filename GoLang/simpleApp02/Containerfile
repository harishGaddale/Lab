# Stage 1: Build the Go binary
FROM golang:1.23-alpine AS go-builder

WORKDIR /app

# CACHE dependencies
COPY go.mod ./
RUN go mod download

# Copy source code
COPY main.go ./

# Compile a linked binary and strip debug symbols for a smaller size
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o simpleApp02 main.go

# Stage2: Final minimal image
FROM alpine:3.20

WORKDIR /app

# Copy the binary from the go-builder stage
COPY --from=go-builder /app/simpleApp02 .

# Expose the application port
EXPOSE 8852

# Run binary
CMD ["./simpleApp02"]
